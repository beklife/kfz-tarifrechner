# nginx als einfaches Gateway: liefert das Angular-Frontend aus und leitet /api/* an die internen Services weiter.
# ${...} ersetzt das nginx-Image beim Start durch Umgebungsvariablen (envsubst).

server {
    listen 8080;
    server_name _;
    server_tokens off;   # nginx-Version nicht verraten

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Einfache Sicherheits-Header für alle Antworten
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Für Docker-HEALTHCHECK und Kubernetes-Probes
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Gemeinsame Einstellungen für beide API-Weiterleitungen
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;   # länger als der Timeout im quote-service (2 s), damit dessen 503 durchkommt

    # Nur diese zwei Pfade gehen nach innen. Actuator, Swagger usw. bleiben von außen unerreichbar.
    location ^~ /api/vehicles {
        proxy_pass ${VEHICLE_SERVICE_URL};
    }

    location ^~ /api/quotes {
        proxy_pass ${QUOTE_SERVICE_URL};
    }

    # Andere /api-Pfade: sofort 404, nicht die Angular-Seite zurückgeben
    location ^~ /api/ {
        return 404;
    }

    # Dateien mit Hash im Namen (main-S7R3OPLW.js) ändern sich nie -> lange cachen
    location ~* \.(?:js|css|woff2?|ico|svg|png)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA-Fallback: /rechner, /ueber usw. gibt es nicht als Datei.
    # nginx liefert dann index.html, und der Angular-Router zeigt die richtige Seite.
    location / {
        add_header Cache-Control "no-cache" always;   # index.html immer frisch laden
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
